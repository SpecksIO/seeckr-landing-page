{
  "config": {
    "default": true,
    // ATX style headings (`# Title`, not underlined)
    "MD003": { "style": "atx" },
    // 2-space indentation for nested lists
    "MD007": { "indent": 2 },
    // No line length limit — Prettier owns wrapping
    "MD013": false,
    // Duplicate headings allowed as long as they are not siblings
    "MD024": { "siblings_only": true },
    // Multiple top-level headings allowed
    "MD025": false,
    // Inline HTML limited to collapsible sections and line breaks
    "MD033": { "allowed_elements": ["details", "summary", "br"] },
    // Fenced code blocks, never indented
    "MD046": { "style": "fenced" },
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "reports/**",
    "**/*.log",
    "**/pnpm-lock.yaml",
    ".git/**",
    // Import directive for Claude Code, not prose
    "CLAUDE.md",
  ],
}
