# Adresse publique du site : métadonnées, URL canoniques, JSON-LD, sitemap.xml,
# robots.txt et llms.txt. Sans valeur, le site suppose https://seeckr.fr.
NEXT_PUBLIC_SITE_URL=https://seeckr.fr

# Formulaire /mon-seeckr : e-mail envoyé par Resend depuis noreply@seeckr.fr.
RESEND_API_KEY=
# Destinataire des demandes.
LEAD_EMAIL_TO=
# Webhook entrant Slack qui reçoit chaque demande.
SLACK_WEBHOOK_URL=
